{
  "admin": {
    "listen": "127.0.0.1:8081"
  },
  "apps": {
    "http": {
      "servers": {
        "srv0": {
          "listen": [":8080"],
          "listener_wrappers": [
            {
              "wrapper": "tcp_brutal",
              "enabled": true,
              "rate_bytes_per_second": 25000000,
              "cwnd_gain": 20,
              "failure_mode": "fallback"
            },
            {
              "wrapper": "tls"
            }
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "file_server",
                  "root": "/var/www"
                }
              ]
            }
          ]
        }
      }
    }
  }
}
